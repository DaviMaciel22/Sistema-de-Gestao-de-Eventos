<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="WPFGestaoDeEventos.View.TelaInicial"
             >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="lblEventosDisponiveis" Text="Eventos disponíveis" Style="{StaticResource TituloTela}"/>

        <!-- Filtros: o botão Filtrar chama EventoController.Buscar (funcionalidade via SQL) -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock x:Name="lblBuscar" Text="Buscar" Style="{StaticResource Rotulo}"/>
                <TextBox x:Name="txtBuscar" ToolTip="Nome do evento"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock x:Name="lblData" Text="Data" Style="{StaticResource Rotulo}"/>
                <DatePicker x:Name="dpData"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="16,0,0,0">
                <TextBlock x:Name="lblCidade" Text="Cidade" Style="{StaticResource Rotulo}"/>
                <ComboBox x:Name="cbCidade" SelectedIndex="0">
                    <ComboBoxItem Content="Todas"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="3" Margin="16,0,0,0">
                <TextBlock x:Name="lblTipo" Text="Tipo" Style="{StaticResource Rotulo}"/>
                <ComboBox x:Name="cbTipo" SelectedIndex="0">
                    <ComboBoxItem Content="Todos"/>
                    <ComboBoxItem Content="Conferência"/>
                    <ComboBoxItem Content="Workshop"/>
                </ComboBox>
            </StackPanel>
            <Button x:Name="btnFiltrar" Grid.Column="4" Content="Filtrar" Height="34" Margin="16,0,0,0"
                    VerticalAlignment="Bottom" Style="{StaticResource BotaoPrincipal}"/>
        </Grid>

        <!-- Cards de evento: a lista rola para baixo (sem carrossel) -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="icEventos" Width="896">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Cartao}" Width="320" Margin="0,0,16,16" Padding="20">
                            <StackPanel>
                                <Border Style="{StaticResource Etiqueta}">
                                    <TextBlock Text="{Binding TipoEvento}"/>
                                </Border>
                                <TextBlock Text="{Binding Titulo}" FontSize="18" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" Margin="0,10,0,6"/>
                                <TextBlock Text="{Binding DataEHora, StringFormat=dd/MM/yyyy · HH:mm}"
                                           Style="{StaticResource TextoSecundario}" Margin="0,0,0,2"/>
                                <TextBlock Style="{StaticResource TextoSecundario}" Margin="0,0,0,2"><Run Text="{Binding Local.Nome}"/><Run Text=" · "/><Run Text="{Binding Local.Cidade}"/></TextBlock>
                                <TextBlock FontWeight="SemiBold"><Run Text="{Binding Valor, StringFormat=C}"/><Run Text=" · "/><Run Text="{Binding VagasRestantes}"/><Run Text=" vagas"/></TextBlock>

                                <!-- Sem vagas, o mesmo botão vira "Esgotado" e fica desabilitado -->
                                <Button Margin="0,16,0,0">
                                    <Button.Style>
                                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource BotaoPrincipal}">
                                            <Setter Property="Content" Value="Garantir ingresso"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding VagasRestantes}" Value="0">
                                                    <Setter Property="Content" Value="Esgotado"/>
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
            <Border x:Name="FundoEvento1" Grid.Row="2" Style="{StaticResource Cartao}" Padding="24" Height="327" Width="317" Margin="0,0,20,0" Background="White" CornerRadius="8">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,25,0,0">
                            <Button x:Name="btnCancelar" Content="Cancelar ingresso" Style="{StaticResource BotaoPerigo}"
                    VerticalAlignment="Top"/>
                            <StackPanel Margin="16,0,0,0">
                                <Button x:Name="btnCertificado" Content="Ver certificado"
                        Style="{StaticResource BotaoSecundario}" IsEnabled="False"/>
                                <TextBlock x:Name="lblAviso" Text="(só depois do check-in)" FontSize="11"
                        Style="{StaticResource TextoSecundario}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock x:Name="txtTituloEvento" Text="Selecione um ingresso"
                    FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <WrapPanel Margin="0,0,0,6">
                                <TextBlock x:Name="lblDataEHoraEvento" Margin="0,0,32,0"><Run Foreground="#FF64748B" Text="Data"/><Run Foreground="#FF64748B" Language="pt-br" Text=" "/><Run Foreground="#FF64748B" Text="E"/><Run Foreground="#FF64748B" Language="pt-br" Text=" "/><Run Foreground="#FF64748B" Text="Hora"/><Run Foreground="#FF64748B" Text=": "/><Run x:Name="runData"/></TextBlock>
                                <TextBlock x:Name="lblTipoEvento" RenderTransformOrigin="0.477,0.512"><Run Text="Tipo: " Foreground="{StaticResource CorTextoSecundario}"/><Run x:Name="runTipo"/></TextBlock>
                            </WrapPanel>
                            <TextBlock x:Name="lblDuracao" Margin="0,0,0,6"><Run Text="Duração: " Foreground="{StaticResource CorTextoSecundario}"/><Run x:Name="runDuração"/></TextBlock>
                            <TextBlock x:Name="lblLocal" Margin="0,0,0,6"><Run Text="Local: " Foreground="{StaticResource CorTextoSecundario}"/><Run x:Name="runLocal"/></TextBlock>
                            <TextBlock x:Name="lblDescricao" TextWrapping="Wrap" Margin="0,0,0,16"><Run Text="Descrição: " Foreground="{StaticResource CorTextoSecundario}"/><Run x:Name="runDescricao"/></TextBlock>

                            <!-- Palestras: composição Evento → Palestra -->
                            <TextBlock x:Name="lblPalestras" Style="{StaticResource TextoSecundario}" Margin="0,0,0,4"><Run Text="Palestras"/><Run Language="pt-br" Text=":"/></TextBlock>
                            <ItemsControl x:Name="icPalestras" Margin="12,0,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,0,0,2"><Run Text="•  "/><Run Text="{Binding DataEHora, StringFormat=HH:mm}" Foreground="{StaticResource CorPrincipal}"/><Run Text=" "/><Run Text="{Binding Titulo}"/><Run Text=" — "/><Run Text="{Binding Palestrante.Nome}"/></TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <WrapPanel>
                                <TextBlock x:Name="lblCodigoDoIngresso" Margin="0,0,32,0"><Run Text="Código do ingresso: " Foreground="{StaticResource CorTextoSecundario}"/><Run x:Name="runCodigo"/></TextBlock>
                                <TextBlock x:Name="lblStatusMeusIngressos1"><Run Text="Status: " Foreground="{StaticResource CorTextoSecundario}"/><Run x:Name="runStatus"/></TextBlock>
                            </WrapPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

            <Border x:Name="FundoEvento2" Grid.Row="2" Style="{StaticResource Cartao}" Padding="24" Height="327" Width="317" Margin="0,0,20,0" Background="White" CornerRadius="8">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,25,0,0">
                            <Button x:Name="btnCancelar1" Content="Cancelar ingresso" Style="{StaticResource BotaoPerigo}"
                VerticalAlignment="Top"/>
                            <StackPanel Margin="16,0,0,0">
                                <Button x:Name="btnCertificado1" Content="Ver certificado"
                    Style="{StaticResource BotaoSecundario}" IsEnabled="False"/>
                                <TextBlock x:Name="lblAviso1" Text="(só depois do check-in)" FontSize="11"
                    Style="{StaticResource TextoSecundario}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock x:Name="txtTituloEvento1" Text="Selecione um ingresso"
                FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <WrapPanel Margin="0,0,0,6">
                                <TextBlock x:Name="lblDataEHoraEvento1" Margin="0,0,32,0"><Run Foreground="#FF64748B" Text="Data"/><Run Foreground="#FF64748B" Language="pt-br" Text=" "/><Run Foreground="#FF64748B" Text="E"/><Run Foreground="#FF64748B" Language="pt-br" Text=" "/><Run Foreground="#FF64748B" Text="Hora"/><Run Foreground="#FF64748B" Text=": "/><Run x:Name="runData1"/></TextBlock>
                                <TextBlock x:Name="lblTipoEvento1" RenderTransformOrigin="0.477,0.512"><Run Text="Tipo: " Foreground="{StaticResource CorTextoSecundario}"/><Run x:Name="runTipo1"/></TextBlock>
                            </WrapPanel>
                            <TextBlock x:Name="lblDuracao1" Margin="0,0,0,6"><Run Text="Duração: " Foreground="{StaticResource CorTextoSecundario}"/><Run x:Name="runDuração1"/></TextBlock>
                            <TextBlock x:Name="lblLocal1" Margin="0,0,0,6"><Run Text="Local: " Foreground="{StaticResource CorTextoSecundario}"/><Run x:Name="runLocal1"/></TextBlock>
                            <TextBlock x:Name="lblDescricao1" TextWrapping="Wrap" Margin="0,0,0,16"><Run Text="Descrição: " Foreground="{StaticResource CorTextoSecundario}"/><Run x:Name="runDescricao1"/></TextBlock>

                            <!-- Palestras: composição Evento → Palestra -->
                            <TextBlock x:Name="lblPalestras1" Style="{StaticResource TextoSecundario}" Margin="0,0,0,4"><Run Text="Palestras"/><Run Language="pt-br" Text=":"/></TextBlock>
                            <ItemsControl x:Name="icPalestras1" Margin="12,0,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,0,0,2"><Run Text="•  "/><Run Text="{Binding DataEHora, StringFormat=HH:mm}" Foreground="{StaticResource CorPrincipal}"/><Run Text=" "/><Run Text="{Binding Titulo}"/><Run Text=" — "/><Run Text="{Binding Palestrante.Nome}"/></TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <WrapPanel>
                                <TextBlock x:Name="lblCodigoDoIngresso1" Margin="0,0,32,0"><Run Text="Código do ingresso: " Foreground="{StaticResource CorTextoSecundario}"/><Run x:Name="runCodigo1"/></TextBlock>
                                <TextBlock x:Name="lblStatusMeusIngressos2"><Run Text="Status: " Foreground="{StaticResource CorTextoSecundario}"/><Run x:Name="runStatus1"/></TextBlock>
                            </WrapPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>
        </WrapPanel>

    </Grid>
</UserControl>
    