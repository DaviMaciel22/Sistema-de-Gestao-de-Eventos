<UserControl x:Class="WPFGestaoDeEventos.View.TelaInicial"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <TextBlock Text="Eventos Disponíveis" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Lista Dinâmica de Eventos -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ListaEventos">
                <!-- Template de como cada evento será desenhado na tela -->
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="8" Margin="0,0,0,15" Padding="15" Background="#F9F9F9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <!-- Os Bindings puxam os atributos da sua classe Evento -->
                                    <TextBlock Text="{Binding Titulo}" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding DataEHora, StringFormat=dd/MM/yyyy HH:mm}" Foreground="Gray" Margin="0,5,0,10"/>
                                    <TextBlock Text="{Binding Descricao}" TextWrapping="Wrap" Margin="0,0,20,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Valor, StringFormat=R$ {0:F2}}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <Button Content="Ver mais" Margin="0,0,0,5" Padding="15,5" Background="Transparent" BorderBrush="Gray" BorderThickness="1"/>
                                    <Button Content="Comprar" Padding="15,5" Background="#28A745" Foreground="White" BorderThickness="0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
    