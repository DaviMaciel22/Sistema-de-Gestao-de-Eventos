<UserControl x:Class="WPFGestaoDeEventos.View.TelaInicial"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Eventos disponíveis" Style="{StaticResource TituloTela}"/>

        <!-- Filtros: o botão Filtrar chama EventoController.Buscar (funcionalidade via SQL) -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Buscar" Style="{StaticResource Rotulo}"/>
                <TextBox x:Name="txtBuscar" ToolTip="Nome do evento"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock Text="Data" Style="{StaticResource Rotulo}"/>
                <DatePicker x:Name="dpData"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="16,0,0,0">
                <TextBlock Text="Cidade" Style="{StaticResource Rotulo}"/>
                <ComboBox x:Name="cbCidade" SelectedIndex="0">
                    <ComboBoxItem Content="Todas"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="3" Margin="16,0,0,0">
                <TextBlock Text="Tipo" Style="{StaticResource Rotulo}"/>
                <ComboBox x:Name="cbTipo" SelectedIndex="0">
                    <ComboBoxItem Content="Todos"/>
                    <ComboBoxItem Content="Conferência"/>
                    <ComboBoxItem Content="Workshop"/>
                </ComboBox>
            </StackPanel>
            <Button x:Name="btnFiltrar" Grid.Column="4" Content="Filtrar" Height="34" Margin="16,0,0,0"
                    VerticalAlignment="Bottom" Style="{StaticResource BotaoPrincipal}"/>
        </Grid>

        <!-- Cards de evento: a lista rola para baixo (sem carrossel) -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="icEventos">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Cartao}" Width="320" Margin="0,0,16,16" Padding="20">
                            <StackPanel>
                                <Border Style="{StaticResource Etiqueta}">
                                    <TextBlock Text="{Binding TipoEvento}"/>
                                </Border>
                                <TextBlock Text="{Binding Titulo}" FontSize="18" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" Margin="0,10,0,6"/>
                                <TextBlock Text="{Binding DataEHora, StringFormat=dd/MM/yyyy · HH:mm}"
                                           Style="{StaticResource TextoSecundario}" Margin="0,0,0,2"/>
                                <TextBlock Style="{StaticResource TextoSecundario}" Margin="0,0,0,2">
                                    <Run Text="{Binding Local.Nome}"/><Run Text=" · "/><Run Text="{Binding Local.Cidade}"/>
                                </TextBlock>
                                <TextBlock FontWeight="SemiBold">
                                    <Run Text="{Binding Valor, StringFormat=C}"/><Run Text=" · "/><Run Text="{Binding VagasRestantes}"/><Run Text=" vagas"/>
                                </TextBlock>

                                <!-- Sem vagas, o mesmo botão vira "Esgotado" e fica desabilitado -->
                                <Button Margin="0,16,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource BotaoPrincipal}">
                                            <Setter Property="Content" Value="Garantir ingresso"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding VagasRestantes}" Value="0">
                                                    <Setter Property="Content" Value="Esgotado"/>
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
