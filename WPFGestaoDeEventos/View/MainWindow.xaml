<Window x:Class="WPFGestaoDeEventos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:view="clr-namespace:WPFGestaoDeEventos.View"
        Title="Sistema de gerenciamento de eventos" Height="720" Width="1120"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CorFundo}"
        Foreground="{StaticResource CorTexto}"
        FontFamily="Segoe UI"
        Language="pt-BR">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra superior: saudação à esquerda, navegação à direita -->
        <Border Background="{StaticResource CorCartao}" BorderBrush="{StaticResource CorBorda}"
                BorderThickness="0,0,0,1" Padding="32,10">
            <DockPanel>
                <TextBlock x:Name="txtSaudacao" Text="Olá, Ana Souza" FontSize="14"
                           VerticalAlignment="Center" Style="{StaticResource TextoSecundario}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <RadioButton x:Name="rbHome" Content="Home" IsChecked="True"
                                 Style="{StaticResource ItemNavegacao}" Click="BtnEventos_Click"/>
                    <RadioButton x:Name="rbIngressos" Content="Meus Ingressos"
                                 Style="{StaticResource ItemNavegacao}" Click="BtnIngressos_Click"/>
                    <RadioButton x:Name="rbPerfil" Content="Perfil"
                                 Style="{StaticResource ItemNavegacao}" Click="BtnPerfil_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- O ContentControl é o "container" dinâmico que recebe as 3 telas; abre na Home -->
        <ContentControl x:Name="AreaPrincipal" Grid.Row="1" Margin="32,24">
            <view:TelaInicial/>
        </ContentControl>
    </Grid>
</Window>
