<Window x:Class="WPFGestaoDeEventos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFGestaoDeEventos"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <!-- Espaço do Menu Lateral -->
            <ColumnDefinition Width="*"/>
            <!-- Área onde as telas aparecem -->
        </Grid.ColumnDefinitions>

        <!-- Menu Lateral -->
        <StackPanel Grid.Column="0" Background="#2C3E50" Margin="0,0,0,208" Grid.ColumnSpan="2">
            <TextBlock Text="Menu Principal" Foreground="White" FontSize="18" FontWeight="Bold" Margin="20"/>
            <Button Content="Eventos" Click="BtnEventos_Click" Padding="10" Width="108"/>
            <Button Content="Meus Ingressos" Click="BtnIngressos_Click" Margin="10,5" Padding="10" Width="108" RenderTransformOrigin="1.222,0.741"/>
            <Button Content="Meu Perfil" Click="BtnPerfil_Click" Margin="10,5" Padding="10" Width="108"/>
        </StackPanel>

        <!-- O ContentControl é o "container" dinâmico que vai receber as suas 3 telas -->
        <ContentControl x:Name="AreaPrincipal" Grid.Column="1" Margin="10,253,10,10"/>
    </Grid>
</Window>
