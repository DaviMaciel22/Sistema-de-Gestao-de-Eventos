<UserControl x:Class="WPFGestaoDeEventos.View.Perfil"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="20">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="350">

            <!-- Avatar / Ícone -->
            <Ellipse Width="100" Height="100" Fill="#E0E0E0" Stroke="Gray" StrokeThickness="1" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <TextBlock Text="Meu Perfil" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <!-- Campos de Dados -->
            <TextBlock Text="Nome:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtNome" Padding="8" Margin="0,0,0,15" FontSize="14"/>

            <TextBlock Text="E-mail:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtEmail" Padding="8" Margin="0,0,0,25" FontSize="14"/>

            <!-- Botões de Ação -->
            <Button Content="Editar Dados" Padding="10" Background="#28A745" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0" Margin="0,0,0,15"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Alterar Senha" Padding="10" Background="Transparent" BorderBrush="Gray" BorderThickness="1"/>
                <Button Grid.Column="2" Content="Excluir Conta" Padding="10" Background="#DC3545" Foreground="White" BorderThickness="0"/>
            </Grid>

        </StackPanel>
    </Grid>
</UserControl>
    